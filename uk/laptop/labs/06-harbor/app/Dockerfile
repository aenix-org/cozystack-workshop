# Лаба 6 · Свій приватний реєстр образів. Рецепт збірки образу сервісу «Перепустка».
#
# Що таке Dockerfile: покроковий рецепт, за яким з вихідників виходить образ —
# готовий до запуску зліпок файлової системи разом із вказівкою, що в ньому запускати.
# Найближче у vSphere — збірка золотого шаблону ВМ, тільки описана текстом і
# повторювана: один і той самий рецепт дає один і той самий результат на будь-якій машині.
#
# Збирається на вашому ноутбуці, з папки лаби (останній аргумент — папка з цим
# файлом і вихідниками):
#     docker build --platform linux/amd64 -t HARBOR-HOST/passes/passes-api:v1 app/
#     docker push HARBOR-HOST/passes/passes-api:v1
# HARBOR-HOST замініть на адресу свого Harbor: перша частина імені образу — це адреса
# реєстру, за нею docker push і розуміє, куди відправляти.
#
# УВАГА: --platform linux/amd64 обов'язковий на Mac з процесором Apple Silicon і на будь-якому
# ARM-ноутбуці. Без нього збереться образ під ARM: збереться без помилок, відправиться
# у реєстр без помилок, а в кластері (вузли там на x86) впаде з «exec format error».
#
# Кожен рядок рецепта створює шар — незмінний зріз файлової системи. Шари
# кешуються і перевикористовуються: тому файли копіюються по одному, а не папкою
# цілком, — правка main.go не змушує заново тягнути залежності.
#
# ДВА ЕТАПИ. Перший — збірковий: сюди потрібен весь компілятор Go, а це приблизно 350 МБ.
# Другий — те, що поїде в кластер: туди переноситься тільки готовий бінарник.
# Підсумковий образ виходить близько 10 МБ замість 350, і всередині нього немає ні компілятора,
# ні вихідників, ні пакетного менеджера — тобто нічим скористатися тому, хто
# в контейнер усе-таки потрапив.

# --- Етап 1: збірка -----------------------------------------------------------------
# FROM — з якого готового образу починаємо. Тут офіційний образ з компілятором Go
# поверх Alpine (мінімальний Linux, кілька мегабайтів). Версія зафіксована: з тегом
# latest один і той самий рецепт через півроку зібрав би інше.
# AS build — ім'я етапу, за ним другий етап забере результат.
FROM golang:1.23-alpine AS build
# Робоча папка всередині образу: подальші команди виконуються відносно неї.
# Якщо папки немає, вона створюється.
WORKDIR /src
# go.mod — опис модуля: ім'я і версія Go. Зовнішніх залежностей у застосунку немає,
# тому завантажувати з інтернету нічого, і збірка проходить там, де виходу назовні немає.
COPY go.mod ./
# Сам вихідник. Копіюється окремим рядком, щоб правка коду не скидала кеш
# попереднього шару.
COPY main.go ./
# RUN виконує команду під час збірки (не під час запуску) і зберігає результат шаром.
#   CGO_ENABLED=0  зібрати статично, без прив'язки до системних бібліотек. Без цього
#                  бінарнику знадобиться glibc, якої в кінцевому образі не буде,
#                  і контейнер впаде під час старту, а не під час збірки
#   -trimpath      прибрати з бінарника шляхи збіркової машини: збірка стає
#                  відтворюваною, і назовні не виїжджає ім'я вашої домашньої папки
#   -ldflags="-s -w"  викинути відлагоджувальні таблиці — файл стає помітно меншим
#   -o /out/...    куди покласти результат; звідси його забере другий етап
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/passes-api .

# --- Етап 2: те, що поїде в кластер -----------------------------------------------
# Другий FROM починає образ заново, з чистого аркуша: усе нажите на першому етапі
# залишається там і в підсумковий образ не потрапляє.
FROM alpine:3.21
# Заводимо користувача, під яким працюватиме застосунок: від root воно працювати
# не повинно. У правильно налаштованому кластері під від root не пустять зовсім, і це не
# причіпка, а стандартна вимога безпеки.
#   -D          створити без пароля, не ставлячи запитань
#   -u 10001    числовий ідентифікатор; кластер перевіряє саме число, а не ім'я
RUN adduser -D -u 10001 app
# Єдине, що переноситься з першого етапу, — готовий бінарник. --from=build
# вказує на ім'я етапу. /usr/local/bin — папка, яка є в PATH будь-якого Linux.
COPY --from=build /out/passes-api /usr/local/bin/passes-api
# З цього місця процес у контейнері працює під користувачем 10001, а не під root.
# Порядок важливий: рядки вище виконувалися від root, інакше adduser не спрацював би.
USER 10001
# Оголошення порту — довідковий запис для людини та інструментів. Порт вона не
# відкриває і нічого не налаштовує: доступ до нього описаний у маніфесті (passes.yaml).
EXPOSE 8080
# Що запускати під час старту контейнера. Форма списком, а не рядком: так команда
# запускається напряму, без проміжної оболонки, і сигнал зупинки від кластера
# доходить до самого застосунку, а не до shell, який його породив.
ENTRYPOINT ["/usr/local/bin/passes-api"]
